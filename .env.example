# ============================================================
#  Einstellungen für den Fantasy-Assistenten
#
#  So geht's: Diese Datei kopieren und die Kopie ".env" nennen
#  (start.bat macht das beim ersten Start automatisch).
#  In die .env kommen deine geheimen Schlüssel. Die .env wird
#  NIE ins Git-Repo hochgeladen (steht in .gitignore).
#  Zeilen mit # am Anfang sind Kommentare.
# ============================================================

# ---------- Sicherheit ----------
# Dry-Run: true = es wird nichts an Yahoo gesendet, alles nur simuliert und protokolliert.
# Erst auf false stellen, wenn du das wirklich willst.
DRY_RUN=true

# Tägliche Aufstellung automatisch setzen (ab Phase 3, nur falls Yahoo Schreibzugriff erlaubt).
AUTO_LINEUP=false

# ---------- Web-Oberfläche ----------
# 127.0.0.1 = nur auf diesem PC erreichbar.
# 0.0.0.0 = auch vom Handy im selben WLAN erreichbar (Adresse: http://<IP-deines-PCs>:8000).
HOST=127.0.0.1
PORT=8000
# Browser beim Start automatisch öffnen
OPEN_BROWSER=true

# ---------- KI (optional) ----------
# Ohne Schlüssel funktioniert alles, nur der Knopf "KI um Rat fragen" fehlt.
# Schlüssel bekommst du auf https://console.anthropic.com (siehe README, Abschnitt "KI einrichten").
ANTHROPIC_API_KEY=
# Modell: claude-sonnet-5 (Standard) oder claude-haiku-4-5 (etwa halb so teuer)
AI_MODEL=claude-sonnet-5
# Maximale KI-Kosten pro Tag in US-Dollar. Danach macht die KI Pause bis morgen.
AI_DAILY_BUDGET_USD=0.50

# ---------- Yahoo (funktioniert erst nach der Freigabe durch Yahoo) ----------
# Aus deiner Yahoo-Entwickler-App (siehe docs/YAHOO_ANTRAG.md).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Muss exakt so in deiner Yahoo-App eingetragen sein.
YAHOO_REDIRECT_URI=https://localhost:8000/auth/callback
# Deine Liga-ID (die Zahl hinter /nba/ in der Liga-Adresse)
YAHOO_LEAGUE_ID=60530
# Nur ändern, wenn Yahoo es verlangt (z. B. fspt-r). Leer lassen = Berechtigungen der Yahoo-App.
YAHOO_SCOPE=
